<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="RadioGroup">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="RadioButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingTop">-8dp</item>
        <item name="android:paddingBottom">-8dp</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:layout_marginTop">@dimen/button_vertical_minus_margin</item>
        <item name="android:layout_marginBottom">@dimen/button_vertical_minus_margin</item>
    </style>

    <style name="Checkbox">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">-0.04</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:layout_marginTop">@dimen/button_vertical_minus_margin</item>
        <item name="android:layout_marginBottom">@dimen/button_vertical_minus_margin</item>
    </style>

    <!-- GridLayout(2열) 안의 체크박스: 열을 균등 분할 -->
    <style name="Checkbox.BoxOnly" parent="Checkbox">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_weight">0</item>
    </style>

    <style name="SeekBar">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">25dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">5dp</item>
        <item name="android:progressTint">@color/light_blue_600</item>
        <item name="android:thumbTint">@color/light_blue_600</item>
    </style>

    <style name="EditTextStyle" parent="Widget.AppCompat.EditText">
        <item name="android:backgroundTint">@color/edittext_bottom_line_filter_tint</item>
    </style>

    <style name="TabText" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">-0.04</item>
        <item name="android:textStyle">bold|italic</item>
    </style>

    <style name="TextView">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:letterSpacing">-0.04</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="MaterialButton.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">46dp</item>
        <item name="android:letterSpacing">-0.04</item>
        <item name="android:maxLines">2</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="TextViewDisabled" parent="TextView">
        <item name="android:gravity">center</item>
        <item name="android:maxLines">5</item>
        <item name="android:textColor">@color/widget_font_main</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="SmallMaterialButton">
        <item name="android:layout_gravity">center_horizontal</item>
        <item name="android:letterSpacing">-0.04</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:paddingTop">5dp</item>
        <item name="android:paddingBottom">5dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:textSize">14sp</item>
        <item name="android:gravity">center</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="MaterialButton">
        <item name="android:layout_gravity">center_horizontal</item>
        <item name="android:letterSpacing">-0.04</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">46dp</item>
        <item name="android:paddingTop">5dp</item>
        <item name="android:paddingBottom">5dp</item>
        <item name="android:paddingLeft">20dp</item>
        <item name="android:paddingRight">20dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:textSize">18sp</item>
        <item name="android:gravity">center</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="AddWidgetRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingVertical">6dp</item>
    </style>

    <style name="AddWidgetPreview">
        <item name="android:layout_width">130dp</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <style name="AddWidgetLabel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">14dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="NotiChip" parent="Widget.Material3.Chip.Filter">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">13sp</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipBackgroundColor">@color/noti_chip_bg</item>
        <item name="chipIconSize">22dp</item>
        <item name="chipIconTint">@null</item>
        <item name="chipIconVisible">true</item>
        <item name="chipStrokeColor">@color/noti_chip_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="ensureMinTouchTargetSize">false</item>
    </style>

    <style name="NotiChipCustomText" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">@color/noti_chip_custom_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold|italic</item>
    </style>

    <style name="NotiChip.Custom">
        <item name="android:textAppearance">@style/NotiChipCustomText</item>
        <item name="android:textColor">@color/noti_chip_custom_text</item>
    </style>
    <style name="NotiRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
    </style>
</resources>
