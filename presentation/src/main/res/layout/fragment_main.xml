<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />
        <import type="danggai.app.presentation.ui.main.CustomNotiType" />

        <variable
            name="vm"
            type="danggai.app.presentation.ui.main.MainViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#f5f5f5">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/ns_body"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="#f5f5f5"
            app:layout_constraintBottom_toTopOf="@id/ad_view"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:context=".ui.main.MainFragment">

            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/main"
                android:layout_width="match_parent"
                android:animateLayoutChanges="true"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingHorizontal="12dp">

                <android.widget.Space
                    android:layout_width="wrap_content"
                    android:layout_height="15dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_accounts"
                    item="@{vm.sfAccountList}"
                    refreshSwitch="@{vm.sfAccountListRefreshSwitch}"
                    viewModel="@{vm}"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="@{vm.sfAccountList.empty ?View.GONE :View.VISIBLE}"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

                <TextView
                    style="@style/TextView"
                    android:layout_width="match_parent"
                    android:gravity="center"
                    android:paddingVertical="20dp"
                    android:text="@string/no_hoyolab_accounts"
                    android:textColor="@color/black"
                    android:visibility="@{vm.sfAccountList.empty ?View.VISIBLE :View.GONE}" />

                <com.google.android.material.button.MaterialButton
                    style="@style/MaterialButton.Secondary"
                    android:layout_width="match_parent"
                    android:onClick="@{()->vm.onClickNewHoyolabAccount()}"
                    android:text="@string/new_hoyolab_account"
                    app:icon="@drawable/baseline_person_add_24"
                    app:iconGravity="textStart"
                    app:iconSize="22dp" />


                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Material3.CardView.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp">

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:animateLayoutChanges="true"
                        android:padding="14dp">
                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/TextView"
                    android:layout_width="match_parent"
                    android:text="@string/refresh_cycle"
                    android:textColor="@color/black"
                    android:textSize="20sp"
                    android:textStyle="bold|italic" />

                <com.google.android.material.chip.ChipGroup
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    app:chipSpacingHorizontal="8dp"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        style="@style/NotiChip"
                        android:checked="@{vm.sfAutoRefreshPeriod != 15L &amp;&amp; vm.sfAutoRefreshPeriod != 30L &amp;&amp; vm.sfAutoRefreshPeriod != 60L &amp;&amp; vm.sfAutoRefreshPeriod != 120L}"
                        android:onClick="@{() -> vm.onClickSetAutoRefreshPeriod(-1L)}"
                        android:text="@string/disable"
                        app:chipIcon="@drawable/baseline_close_24"
                        app:chipIconTint="@color/black" />
                    <com.google.android.material.chip.Chip
                        style="@style/NotiChip"
                        android:checked="@{vm.sfAutoRefreshPeriod == 15L}"
                        android:onClick="@{() -> vm.onClickSetAutoRefreshPeriod(15L)}"
                        android:text="@string/time_15m"
                        app:chipIcon="@drawable/baseline_sync_24"
                        app:chipIconTint="@color/black" />
                    <com.google.android.material.chip.Chip
                        style="@style/NotiChip"
                        android:checked="@{vm.sfAutoRefreshPeriod == 30L}"
                        android:onClick="@{() -> vm.onClickSetAutoRefreshPeriod(30L)}"
                        android:text="@string/time_30m"
                        app:chipIcon="@drawable/baseline_sync_24"
                        app:chipIconTint="@color/black" />
                    <com.google.android.material.chip.Chip
                        style="@style/NotiChip"
                        android:checked="@{vm.sfAutoRefreshPeriod == 60L || vm.sfAutoRefreshPeriod == 120L}"
                        android:onClick="@{() -> vm.onClickSetAutoRefreshPeriod(60L)}"
                        android:text="@string/time_1h"
                        app:chipIcon="@drawable/baseline_sync_24"
                        app:chipIconTint="@color/black" />

                </com.google.android.material.chip.ChipGroup>

                    </androidx.appcompat.widget.LinearLayoutCompat>

                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Material3.CardView.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp">

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:animateLayoutChanges="true"
                        android:padding="14dp">
                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/TextView"
                    android:layout_width="match_parent"
                    android:text="@string/notification"
                    android:textColor="@color/black"
                    android:textSize="20sp"
                    android:textStyle="bold|italic" />

                <androidx.appcompat.widget.LinearLayoutCompat style="@style/NotiRow">

                    <androidx.appcompat.widget.AppCompatTextView
                        style="@style/TextView"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/noti_time_daily"
                        android:textColor="@color/black"
                        android:textSize="16sp" />

                    <androidx.appcompat.widget.AppCompatSpinner
                        android:id="@+id/sp_daily_yet_noti"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_spinner" />

                </androidx.appcompat.widget.LinearLayoutCompat>

                <androidx.appcompat.widget.LinearLayoutCompat style="@style/NotiRow">

                    <androidx.appcompat.widget.AppCompatTextView
                        style="@style/TextView"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/noti_time_weekly"
                        android:textColor="@color/black"
                        android:textSize="16sp" />

                    <androidx.appcompat.widget.AppCompatSpinner
                        android:id="@+id/sp_weekly_yet_noti_day"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_spinner" />
                    <androidx.appcompat.widget.AppCompatSpinner
                        android:id="@+id/sp_weekly_yet_noti_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_spinner" />

                </androidx.appcompat.widget.LinearLayoutCompat>
                    </androidx.appcompat.widget.LinearLayoutCompat>

                </com.google.android.material.card.MaterialCardView>
                <!--   Genshin   -->

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Material3.CardView.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:adjustViewBounds="true"
                            android:importantForAccessibility="no"
                            android:maxHeight="0dp"
                            android:scaleType="centerInside"
                            android:src="@drawable/logo_genshin"
                            android:tint="#eeeeee" />

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:animateLayoutChanges="true"
                        android:padding="14dp">
                <danggai.app.presentation.view.TitleDividerView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:onClick="@{() -> vm.onClickToggleGenshin()}"
                    app:collapsible="true"
                    app:expanded="@{vm.sfExpandGenshin}"
                    app:titleText="@string/genshin" />

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="4dp"
                    android:visibility="@{vm.sfExpandGenshin ? View.VISIBLE : View.GONE}">

                    <com.google.android.material.chip.ChipGroup
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:chipSpacingHorizontal="8dp"
                        app:chipSpacingVertical="4dp">

                        <com.google.android.material.chip.Chip
                            style="@style/NotiChip"
                            android:checked="@={vm.sfEnableNotiEach40Resin}"
                            android:text="@string/btn_each_40_resin"
                        android:contentDescription="@{@string/resin + ' ' + @string/btn_each_40_resin}"
                            app:chipIcon="@drawable/resin" />
                        <com.google.android.material.chip.Chip
                            style="@style/NotiChip"
                            android:checked="@={vm.sfEnableNoti140Resin}"
                            android:text="@string/btn_180_resin"
                        android:contentDescription="@{@string/resin + ' ' + @string/btn_180_resin}"
                            app:chipIcon="@drawable/resin" />
                        <com.google.android.material.chip.Chip
                            style="@style/NotiChip.Custom"
                            android:checked="@={vm.sfEnableNotiCustomResin}"
                            android:onClick="@{() -> vm.onClickCustomNoti(CustomNotiType.RESIN)}"
                            android:text="@{vm.sfEnableNotiCustomResin ? @string/noti_at_value(vm.sfCustomNotiResin) : @string/btn_custom}"
                        android:contentDescription="@{(vm.sfEnableNotiCustomResin ? @string/noti_at_value(vm.sfCustomNotiResin) : @string/btn_custom) + ' ' + @string/resin}"
                            app:chipIcon="@drawable/resin" />
                        <com.google.android.material.chip.Chip
                            style="@style/NotiChip"
                            android:checked="@={vm.sfEnableNotiExpeditionDone}"
                            android:text="@string/btn_expedition_done"
                            app:chipIcon="@drawable/icon_warp_point" />
                        <com.google.android.material.chip.Chip
                            style="@style/NotiChip"
                            android:checked="@={vm.sfEnableNotiHomeCoinFull}"
                            android:text="@string/btn_home_coin_full"
                            app:chipIcon="@drawable/icon_serenitea_pot" />
                        <com.google.android.material.chip.Chip
                            style="@style/NotiChip"
                            android:checked="@={vm.sfEnableNotiParamReach}"
                            android:text="@string/btn_param_reached"
                            app:chipIcon="@drawable/icon_parametric_transformer" />

                        <com.google.android.material.chip.Chip
                            style="@style/NotiChip"
                            android:checked="@={vm.sfEnableNotiDailyYet}"
                            android:onClick="@{() -> vm.onClickDailyCommissionYetNoti()}"
                            android:text="@string/btn_daily_commission_yet"
                            app:chipIcon="@drawable/icon_daily_commission" />
                        <com.google.android.material.chip.Chip
                            style="@style/NotiChip"
                            android:checked="@={vm.sfEnableNotiWeeklyYet}"
                            android:onClick="@{() -> vm.onClickWeeklyBossYetNoti()}"
                            android:text="@string/btn_weekly_boss_yet"
                            app:chipIcon="@drawable/icon_domain" />
                    </com.google.android.material.chip.ChipGroup>

                </androidx.appcompat.widget.LinearLayoutCompat>
                    </androidx.appcompat.widget.LinearLayoutCompat>

                    </FrameLayout>

                </com.google.android.material.card.MaterialCardView>
                <!--   StarRail   -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Material3.CardView.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:adjustViewBounds="true"
                            android:importantForAccessibility="no"
                            android:maxHeight="0dp"
                            android:scaleType="centerInside"
                            android:src="@drawable/logo_honkai_sr"
                            android:tint="#eeeeee" />

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:animateLayoutChanges="true"
                        android:padding="14dp">
                <danggai.app.presentation.view.TitleDividerView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:onClick="@{() -> vm.onClickToggleHonkaiSr()}"
                    app:collapsible="true"
                    app:expanded="@{vm.sfExpandHonkaiSr}"
                    app:titleText="@string/honkai_sr" />

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="4dp"
                    android:visibility="@{vm.sfExpandHonkaiSr ? View.VISIBLE : View.GONE}">

                    <com.google.android.material.chip.ChipGroup
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:chipSpacingHorizontal="8dp"
                        app:chipSpacingVertical="4dp">

                        <com.google.android.material.chip.Chip
                            style="@style/NotiChip"
                            android:checked="@={vm.sfEnableNotiEach40TrailPower}"
                            android:text="@string/btn_each_60_trailblaze_power"
                        android:contentDescription="@{@string/trailblaze_power + ' ' + @string/btn_each_60_trailblaze_power}"
                            app:chipIcon="@drawable/trailblaze_power" />
                        <com.google.android.material.chip.Chip
                            style="@style/NotiChip"
                            android:checked="@={vm.sfEnableNoti230TrailPower}"
                            android:text="@string/btn_290_trailblaze_power"
                        android:contentDescription="@{@string/trailblaze_power + ' ' + @string/btn_290_trailblaze_power}"
                            app:chipIcon="@drawable/trailblaze_power" />
                        <com.google.android.material.chip.Chip
                            style="@style/NotiChip.Custom"
                            android:checked="@={vm.sfEnableNotiCustomTrailPower}"
                            android:onClick="@{() -> vm.onClickCustomNoti(CustomNotiType.TRAIL_POWER)}"
                            android:text="@{vm.sfEnableNotiCustomTrailPower ? @string/noti_at_value(vm.sfCustomNotiTrailPower) : @string/btn_custom}"
                        android:contentDescription="@{(vm.sfEnableNotiCustomTrailPower ? @string/noti_at_value(vm.sfCustomNotiTrailPower) : @string/btn_custom) + ' ' + @string/trailblaze_power}"
                            app:chipIcon="@drawable/trailblaze_power" />
                        <com.google.android.material.chip.Chip
                            style="@style/NotiChip"
                            android:checked="@={vm.sfEnableNotiHonkaiSrExpeditionDone}"
                            android:text="@string/btn_assignment_done"
                            app:chipIcon="@drawable/icon_warp_point" />
                        <com.google.android.material.chip.Chip
                            style="@style/NotiChip"
                            android:checked="@={vm.sfEnableNotiReserveFullHonkaiSr}"
                            android:text="@string/btn_reserve_full"
                            app:chipIcon="@drawable/icon_reserved_trailblaze_power" />

                        <com.google.android.material.chip.Chip
                            style="@style/NotiChip"
                            android:checked="@={vm.sfEnableNotiDailyYetHonkaiSr}"
                            android:text="@string/btn_daily_training_yet"
                            app:chipIcon="@drawable/icon_activity_chip" />
                        <com.google.android.material.chip.Chip
                            style="@style/NotiChip"
                            android:checked="@={vm.sfEnableNotiWeeklyYetHonkaiSr}"
                            android:text="@string/btn_echo_of_war_yet"
                            app:chipIcon="@drawable/icon_echo_of_war" />
                        <com.google.android.material.chip.Chip
                            style="@style/NotiChip"
                            android:checked="@={vm.sfEnableNotiPeriodScoreHonkaiSr}"
                            android:text="@string/btn_period_score_yet"
                            app:chipIcon="@drawable/icon_simulated_universe"
                            app:chipIconTint="@color/black" />
                    </com.google.android.material.chip.ChipGroup>

                </androidx.appcompat.widget.LinearLayoutCompat>
                    </androidx.appcompat.widget.LinearLayoutCompat>

                    </FrameLayout>

                </com.google.android.material.card.MaterialCardView>
                <!--   ZZZ   -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Material3.CardView.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:adjustViewBounds="true"
                            android:importantForAccessibility="no"
                            android:maxHeight="0dp"
                            android:scaleType="centerInside"
                            android:src="@drawable/logo_zzz"
                            android:tint="#eeeeee" />

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:animateLayoutChanges="true"
                        android:padding="14dp">
                <danggai.app.presentation.view.TitleDividerView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:onClick="@{() -> vm.onClickToggleZZZ()}"
                    app:collapsible="true"
                    app:expanded="@{vm.sfExpandZZZ}"
                    app:titleText="@string/zzz" />

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="4dp"
                    android:visibility="@{vm.sfExpandZZZ ? View.VISIBLE : View.GONE}">

                    <com.google.android.material.chip.ChipGroup
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:chipSpacingHorizontal="8dp"
                        app:chipSpacingVertical="4dp">

                        <com.google.android.material.chip.Chip
                            style="@style/NotiChip"
                            android:checked="@={vm.sfEnableNotiEach40Battery}"
                            android:text="@string/btn_each_40_battery"
                        android:contentDescription="@{@string/battery + ' ' + @string/btn_each_40_battery}"
                            app:chipIcon="@drawable/battery" />
                        <com.google.android.material.chip.Chip
                            style="@style/NotiChip"
                            android:checked="@={vm.sfEnableNotiEach60Battery}"
                            android:text="@string/btn_each_60_battery"
                        android:contentDescription="@{@string/battery + ' ' + @string/btn_each_60_battery}"
                            app:chipIcon="@drawable/battery" />
                        <com.google.android.material.chip.Chip
                            style="@style/NotiChip"
                            android:checked="@={vm.sfEnableNoti230Battery}"
                            android:text="@string/btn_230_battery"
                        android:contentDescription="@{@string/battery + ' ' + @string/btn_230_battery}"
                            app:chipIcon="@drawable/battery" />
                        <com.google.android.material.chip.Chip
                            style="@style/NotiChip.Custom"
                            android:checked="@={vm.sfEnableNotiCustomBattery}"
                            android:onClick="@{() -> vm.onClickCustomNoti(CustomNotiType.BATTERY)}"
                            android:text="@{vm.sfEnableNotiCustomBattery ? @string/noti_at_value(vm.sfCustomNotiBattery) : @string/btn_custom}"
                        android:contentDescription="@{(vm.sfEnableNotiCustomBattery ? @string/noti_at_value(vm.sfCustomNotiBattery) : @string/btn_custom) + ' ' + @string/battery}"
                            app:chipIcon="@drawable/battery" />

                        <com.google.android.material.chip.Chip
                            style="@style/NotiChip"
                            android:checked="@={vm.sfEnableNotiDailyYetZZZ}"
                            android:text="@string/btn_engagement_yet"
                            app:chipIcon="@drawable/icon_fire" />
                        <com.google.android.material.chip.Chip
                            style="@style/NotiChip"
                            android:checked="@={vm.sfEnableNotiWeeklyYetZZZ}"
                            android:text="@string/btn_bounty_commission_yet"
                            app:chipIcon="@drawable/icon_investigation_point" />
                        <com.google.android.material.chip.Chip
                            style="@style/NotiChip"
                            android:checked="@={vm.sfEnableNotiMemberClaimZZZ}"
                            android:text="@string/btn_member_claim_yet"
                            app:chipIcon="@drawable/icon_polychrome" />
                        <com.google.android.material.chip.Chip
                            style="@style/NotiChip"
                            android:checked="@={vm.sfEnableNotiCafeZZZ}"
                            android:text="@string/btn_cafe_yet"
                            app:chipIcon="@drawable/icon_coffee" />
                    </com.google.android.material.chip.ChipGroup>

                    <androidx.appcompat.widget.LinearLayoutCompat style="@style/NotiRow">

                        <com.google.android.material.chip.Chip
                            style="@style/NotiChip"
                            android:checked="@={vm.sfEnableNotiMemberExpireZZZ}"
                            android:text="@string/btn_member_expire_soon"
                            app:chipIcon="@drawable/icon_polychrome" />

                        <androidx.appcompat.widget.AppCompatSpinner
                            android:id="@+id/sp_member_expire_noti_days_zzz"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_spinner" />

                    </androidx.appcompat.widget.LinearLayoutCompat>

                </androidx.appcompat.widget.LinearLayoutCompat>
                    </androidx.appcompat.widget.LinearLayoutCompat>

                    </FrameLayout>

                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Material3.CardView.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp">

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="10dp">

                        <androidx.appcompat.widget.AppCompatTextView
                            style="@style/TextView"
                            android:layout_width="0dp"
                            android:layout_marginEnd="14dp"
                            android:layout_weight="1"
                            android:text="@string/check_in"
                            android:textColor="@color/black"
                            android:textSize="20sp"
                            android:textStyle="bold|italic" />

                        <com.google.android.material.chip.ChipGroup
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:chipSpacingHorizontal="8dp"
                            app:chipSpacingVertical="4dp">

                            <com.google.android.material.chip.Chip
                                style="@style/NotiChip"
                                android:checked="@={vm.sfEnableNotiCheckinSuccess}"
                                android:text="@string/btn_check_in_success"
                                app:chipIcon="@drawable/baseline_check_24"
                                app:chipIconTint="@color/black" />

                            <com.google.android.material.chip.Chip
                                style="@style/NotiChip"
                                android:checked="@={vm.sfEnableNotiCheckinFailed}"
                                android:text="@string/btn_check_in_failed"
                                app:chipIcon="@drawable/baseline_close_24"
                                app:chipIconTint="@color/black" />

                        </com.google.android.material.chip.ChipGroup>

                    </androidx.appcompat.widget.LinearLayoutCompat>

                </com.google.android.material.card.MaterialCardView>

                <android.widget.Space
                    android:layout_width="wrap_content"
                    android:layout_height="15dp" />

                <com.google.android.material.button.MaterialButton
                    style="@style/MaterialButton"
                    android:layout_width="match_parent"
                    android:onClick="@{()->vm.onClickAddWidget()}"
                    android:text="@string/add_widget" />

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        style="@style/MaterialButton.Secondary"
                        android:layout_width="0dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:onClick="@{()->vm.onClickWidgetDesign()}"
                        android:text="@string/widget_customizing" />

                    <com.google.android.material.button.MaterialButton
                        style="@style/MaterialButton.Secondary"
                        android:layout_width="0dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:onClick="@{()->vm.onClickCheckIn()}"
                        android:text="@string/hoyolab_checkin" />

                </androidx.appcompat.widget.LinearLayoutCompat>

                <android.widget.Space
                    android:layout_width="wrap_content"
                    android:layout_height="5dp" />

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/TextView"
                    android:layout_gravity="center_horizontal"
                    android:foreground="?attr/selectableItemBackground"
                    android:onClick="@{()->vm.onClickWidgetRefreshNotWork()}"
                    android:text="@string/dialog_widget_refresh_not_work"
                    android:textColor="@color/light_blue_600"
                    android:textSize="15sp"
                    android:textStyle="bold|italic" />

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/TextView"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="12dp"
                    android:drawablePadding="6dp"
                    android:drawableStart="@drawable/baseline_translate_24"
                    android:drawableTint="@color/gray"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:onClick="@{()->vm.onClickChangeLanguage()}"
                    android:padding="6dp"
                    android:text="@string/change_language"
                    android:textColor="@color/gray"
                    android:textSize="14sp" />

            </androidx.appcompat.widget.LinearLayoutCompat>

        </androidx.core.widget.NestedScrollView>

        <com.google.android.gms.ads.AdView xmlns:ads="http://schemas.android.com/apk/res-auto"
            android:id="@+id/ad_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            ads:adSize="BANNER"
            ads:adUnitId="@string/google_ads_banner_id"
            ads:layout_constraintBottom_toBottomOf="parent"
            ads:layout_constraintLeft_toLeftOf="parent"
            ads:layout_constraintRight_toRightOf="parent"
            ads:layout_constraintTop_toBottomOf="@+id/ns_body" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>